# ─── База данных (PostgreSQL) ───
# Neon / Supabase / Vercel Postgres. Обязательно для Prisma.
# ВАЖНО для Neon: используйте pooler-хост и параметры ниже.
# НЕ добавляйте channel_binding=require — движок Prisma его не поддерживает (соединение рвётся).
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# ─── Хранилище файлов (фото/видео авто) ───
# Vercel Blob (Storage → Create → Blob → скопировать токен)
BLOB_READ_WRITE_TOKEN=""

# ─── Авторизация ───
JWT_SECRET="change-me-to-a-long-random-string"
# Вход в админку (/admin/login): телефон/почта из списка + пароль.
# Временное решение до подключения SMS/VK/Яндекс.
ADMIN_PHONES="89888937288"
ADMIN_EMAILS="madnatec1@yandex.ru"
ADMIN_PASSWORD="смените-на-свой-пароль"

# VK ID
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
# Яндекс ID
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# ─── SMS-провайдер (OTP-вход) ───
SMS_API_KEY=""
SMS_SENDER="avtokorr"

# ─── Уведомления менеджерам ───
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Публичные ───
NEXT_PUBLIC_SITE_URL="https://avtokorr.ru"
