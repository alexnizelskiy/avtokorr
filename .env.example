# ─── База данных (PostgreSQL) ───
# Neon / Supabase / Vercel Postgres. Обязательно для Prisma.
DATABASE_URL="postgresql://user:password@host:5432/avtokorr?sslmode=require"

# ─── Хранилище файлов (фото/видео авто) ───
# Vercel Blob (Storage → Create → Blob → скопировать токен)
BLOB_READ_WRITE_TOKEN=""

# ─── Авторизация ───
JWT_SECRET="change-me-to-a-long-random-string"
# Телефоны/почты, которых при входе делаем администраторами (через запятую)
ADMIN_PHONES=""
ADMIN_EMAILS=""

# VK ID
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
# Яндекс ID
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# ─── SMS-провайдер (OTP-вход) ───
SMS_API_KEY=""
SMS_SENDER="avtokorr"

# ─── Уведомления менеджерам ───
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Публичные ───
NEXT_PUBLIC_SITE_URL="https://avtokorr.ru"
